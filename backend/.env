PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/restoreserve
JWT_SECRET=super_secret_jwt_access_key_2026_restoreserve
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_2026_restoreserve
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ALLOW_ADMIN_REGISTRATION=true
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-admin-password